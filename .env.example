# Doctor's Audio Transcription & Translation Configuration

# Application Settings
PROJECT_NAME="Doctor's Audio Transcription & Translation"
VERSION=1.0.0
API_PREFIX=/api
MAX_AUDIO_SIZE_MB=50

# Speech-to-Text Configuration
# Options: "faster-whisper" (offline default), "groq", "openai"
STT_PROVIDER=faster-whisper
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Optional Cloud STT Credentials (if using cloud providers)
OPENAI_API_KEY=
GROQ_API_KEY=
SPEECH_API_URL=
SPEECH_API_KEY=

# Translation Engine
# Options: "deep-translator", "google", "openai"
TRANSLATION_PROVIDER=deep-translator
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
